<launch>
  <arg name="param_file" default="$(find uav_control)/../../config/sim/sunray-150/sunray-150-basic.yaml" />
  <arg name="uav_name" default="__AUTO__" />
  <arg name="uav_id" default="__AUTO__" />
  <arg name="output_yaml" default="/tmp/sunray_uav_param_resolved.yaml" />
  <arg name="keep_output_yaml" default="true" />

  <node pkg="uav_control"
        type="load_uav_param.py"
        name="load_uav_param"
        output="screen"
        args="--input-yaml $(arg param_file) --uav-name $(arg uav_name) --uav-id $(arg uav_id) --output-yaml $(arg output_yaml) --keep-output-yaml $(arg keep_output_yaml)" />
</launch>
