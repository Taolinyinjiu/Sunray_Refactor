<launch>
  <!-- Load sunray_fsm_config.yaml into /<uav_name><uav_id> -->
  <arg name="fsm_param_file" default="$(find uav_control)/config/sunray_fsm_config.yaml" />
  <arg name="uav_name" default="uav" />
  <arg name="uav_id" default="1" />

  <node pkg="uav_control"
        type="load_fsm_param.py"
        name="load_fsm_param"
        output="screen"
        args="--input-yaml $(arg fsm_param_file) --uav-name $(arg uav_name) --uav-id $(arg uav_id)" />
</launch>