<launch>
  <arg name="uav_id" default="1"/>
  <arg name="pose_topic" default="/vrpn_client_node_1/uav$(arg uav_id)/pose"/>
  <arg name="twist_topic" default="/vrpn_client_node_1/uav$(arg uav_id)/twist"/>
  <arg name="odom_topic" default="/uav$(arg uav_id)/sunray/odometry"/>
  <arg name="require_twist" default="false"/>

  <node pkg="sunray_mocap" type="mocap_odom_node" name="mocap_odom_node" output="screen">
    <param name="uav_id" value="$(arg uav_id)"/>
    <param name="pose_topic" value="$(arg pose_topic)"/>
    <param name="twist_topic" value="$(arg twist_topic)"/>
    <param name="odom_topic" value="$(arg odom_topic)"/>
    <param name="require_twist" value="$(arg require_twist)"/>
  </node>

</launch>
